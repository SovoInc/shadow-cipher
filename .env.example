# Sponsor server
PORT=3003
WALLET_SEED=
SHADOWCIPHER_CONTRACT_ADDRESS=

# Midnight network: preview | preprod | mainnet
MIDNIGHT_NETWORK=preprod
PROOF_SERVER_URL=http://localhost:6300

# SQLite DB path (game pool, sessions, leaderboard)
SQLITE_PATH=/opt/shadow-cipher/data.db

# Pre-created game pool
POOL_TARGET_SIZE=20

# Frontend build-time (Vite).
# VITE_SPONSOR_URL: absolute URL the browser hits for /api/* and /sponsor.
# In production behind nginx it's the same origin (e.g. http://shadow.sovo.com)
# or left blank so the frontend uses relative /api paths.
VITE_SPONSOR_URL=
VITE_CONTRACT_ADDRESS=
