pragma language_version >= 0.21;

import CompactStandardLibrary;

// Public ledger state for the game
export ledger commitment: Bytes<32>;
export ledger attempts: Counter;
export ledger solved: Boolean;

// Initialize a new game with a commitment hash
// @disclose: new_commitment
export circuit initialize(new_commitment: Bytes<32>): [] {
  commitment = disclose(new_commitment);
  solved = false;
}

// Record a guess and increment attempts
// @disclose: is_solved  
export circuit record_guess(is_solved: Boolean): [] {
  attempts.increment(1);
  solved = disclose(is_solved);
}
